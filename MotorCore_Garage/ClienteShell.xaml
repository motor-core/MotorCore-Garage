<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MotorCore_Garage.ClienteShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MotorCore_Garage.Pages"
    xmlns:mi="clr-namespace:MauiIcons.Material;assembly=MauiIcons.Material"
    Title="Motor Core"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Card}, Dark={StaticResource CardDark}}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource InkMuted}">

    <TabBar>
        <ShellContent Title="Inicio" Route="cliente-inicio" Icon="{mi:Material Icon=Home, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:ClienteInicioPage}" />
        <ShellContent Title="Vehículos" Route="cliente-vehiculos" Icon="{mi:Material Icon=DirectionsCar, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:ClienteVehiculosPage}" />
        <ShellContent Title="Citas" Route="cliente-citas" Icon="{mi:Material Icon=CalendarMonth, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:ClienteCitasPage}" />
        <ShellContent Title="Cuenta" Route="cliente-cuenta" Icon="{mi:Material Icon=AccountCircle, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:ClienteCuentaPage}" />
    </TabBar>
</Shell>
