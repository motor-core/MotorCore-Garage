<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MotorCore_Garage.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:MotorCore_Garage.Pages"
    xmlns:mi="clr-namespace:MauiIcons.Material;assembly=MauiIcons.Material"
    Title="Motor Core"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Card}, Dark={StaticResource CardDark}}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource InkMuted}">

    <TabBar>
        <ShellContent Title="Inicio" Route="inicio" Icon="{mi:Material Icon=Home, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:InicioPage}" />
        <ShellContent Title="Agenda" Route="agenda" Icon="{mi:Material Icon=CalendarMonth, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:AgendaPage}" />
        <ShellContent Title="Vehículos" Route="vehiculos" Icon="{mi:Material Icon=DirectionsCar, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:VehiculosPage}" />
        <ShellContent Title="Alertas" Route="alertas" Icon="{mi:Material Icon=NotificationsNone, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:AlertasPage}" />
        <ShellContent Title="Más" Route="mas" Icon="{mi:Material Icon=MoreHoriz, IconColor=#8A9199, IconSize=24}" ContentTemplate="{DataTemplate pages:MasPage}" />
    </TabBar>
</Shell>
