<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.ModalPage"
             BackgroundColor="#99000000"
             NavigationPage.HasNavigationBar="False">

    <Grid Padding="24">
        <Border Style="{StaticResource Tarjeta}" StrokeShape="RoundRectangle 24" Padding="24" VerticalOptions="Center">
            <VerticalStackLayout Spacing="16">
                <Label x:Name="Titulo" Style="{StaticResource CuerpoStrong}" FontSize="18" />
                <Label x:Name="Mensaje" Style="{StaticResource Pie}" FontSize="15" />
                <Entry x:Name="Entrada" Style="{StaticResource Campo}" IsVisible="False" Completed="OnEntrada" />
                <Grid x:Name="Acciones" ColumnSpacing="8" RowSpacing="8" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
