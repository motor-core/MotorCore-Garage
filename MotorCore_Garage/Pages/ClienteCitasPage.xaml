<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Material;assembly=MauiIcons.Material"
             xmlns:fab="clr-namespace:MauiIcons.FontAwesome.Brand;assembly=MauiIcons.FontAwesome.Brand"
             x:Class="MotorCore_Garage.Pages.ClienteCitasPage"
             Style="{StaticResource Pagina}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <VerticalStackLayout Style="{StaticResource Hero}">
                <Label Text="Mis citas" Style="{StaticResource HeroTitulo}" />
                <Label Text="Próximas y pasadas" Style="{StaticResource HeroSubtitulo}" />
            </VerticalStackLayout>

            <VerticalStackLayout Padding="16,20,16,32" Spacing="20">
                <Button Text="Solicitar cita" Style="{StaticResource BotonPrimario}" Clicked="OnSolicitar"
                        ImageSource="{mi:Material Icon=EventAvailable, IconColor=White, IconSize=20}" />
                <Button Text="Agendar cita por WhatsApp" Style="{StaticResource BotonSecundario}" Clicked="OnAgendar"
                        ImageSource="{fab:FontAwesomeBrand Icon=Whatsapp, IconColor=White, IconSize=20}" />

                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="6"><Image Source="{mi:Material Icon=CalendarMonth, IconColor=#E8701A, IconSize=20}" VerticalOptions="Center" /><Label Text="Próximas" Style="{StaticResource Seccion}" VerticalOptions="Center" /></HorizontalStackLayout>
                    <VerticalStackLayout x:Name="Proximas" Spacing="12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionPasadas" Spacing="12">
                    <HorizontalStackLayout Spacing="6"><Image Source="{mi:Material Icon=Receipt, IconColor=#E8701A, IconSize=20}" VerticalOptions="Center" /><Label Text="Pasadas" Style="{StaticResource Seccion}" VerticalOptions="Center" /></HorizontalStackLayout>
                    <VerticalStackLayout x:Name="Pasadas" Spacing="12" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
