<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.ClienteNuevoMantenimientoPage"
             Title="Programar mantenimiento"
             Style="{StaticResource Pagina}">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Style="{StaticResource BarraVolver}" ColumnDefinitions="Auto,*">
            <Button Text="‹" FontSize="24" BackgroundColor="Transparent" TextColor="{StaticResource White}"
                    WidthRequest="48" HeightRequest="48" Padding="0" Clicked="OnVolver" />
            <Label Grid.Column="1" Text="Programar mantenimiento" Style="{StaticResource CabeceraTitulo}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,32" Spacing="16">
                <Border Style="{StaticResource Tarjeta}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Tipo" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="Tipo" Title="Elige un mantenimiento" FontSize="16" HeightRequest="48" SelectedIndexChanged="OnTipo" />

                        <Label Text="Nombre" Style="{StaticResource Etiqueta}" />
                        <Entry x:Name="Nombre" Style="{StaticResource Campo}" Placeholder="Ej. Cambio de aceite sintético" MaxLength="80" ReturnType="Next" />

                        <Label Text="Cada cuántos km" Style="{StaticResource Etiqueta}" />
                        <Entry x:Name="KmCada" Style="{StaticResource Campo}" Placeholder="0 = sin límite" Keyboard="Numeric" />

                        <Label Text="Cada cuántos meses" Style="{StaticResource Etiqueta}" />
                        <Entry x:Name="MesesCada" Style="{StaticResource Campo}" Placeholder="0 = sin límite" Keyboard="Numeric" />

                        <Label Text="Kilometraje de la última vez" Style="{StaticResource Etiqueta}" />
                        <Entry x:Name="KmUltimo" Style="{StaticResource Campo}" Keyboard="Numeric" />

                        <Label Text="Fecha de la última vez" Style="{StaticResource Etiqueta}" />
                        <DatePicker x:Name="Fecha" Format="dd MMM yyyy" FontSize="16" HeightRequest="48" />

                        <Label x:Name="Error" TextColor="{StaticResource WearDue}" FontSize="14" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Te avisaremos cuando falte poco o ya haya vencido. Lo que llegue primero (km o meses) manda."
                       Style="{StaticResource Pie}" HorizontalTextAlignment="Center" />

                <Button Text="Guardar mantenimiento" Style="{StaticResource BotonPrimario}" Clicked="OnGuardar" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
