<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.RegistroPage"
             Style="{StaticResource Pagina}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <VerticalStackLayout Style="{StaticResource Hero}" Padding="24,56,24,24">
                <GraphicsView x:Name="Logo" HeightRequest="64" WidthRequest="64" HorizontalOptions="Start" Margin="0,0,0,12" />
                <Label x:Name="Titulo" Style="{StaticResource HeroTitulo}" />
                <Label x:Name="Subtitulo" Style="{StaticResource HeroSubtitulo}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Tarjeta}" Margin="16,20,16,24" Padding="20">
                <VerticalStackLayout Spacing="12">

                    <!-- Tipo de cuenta: taller (monitoreo) o cliente -->
                    <Label Text="Tipo de cuenta" Style="{StaticResource Etiqueta}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="BotonModoMonitor" Text="Monitor" HeightRequest="48" FontSize="14" Clicked="OnModoMonitor" />
                        <Button x:Name="BotonModoCliente" Grid.Column="1" Text="Cliente" HeightRequest="48" FontSize="14" Clicked="OnModoCliente" />
                    </Grid>
                    <Label x:Name="AyudaModo" Style="{StaticResource Pie}" />

                    <!-- Monitor: datos del taller -->
                    <VerticalStackLayout x:Name="CampoTaller" Spacing="12">
                        <Label Text="Nombre del taller" Style="{StaticResource Etiqueta}" />
                        <Entry x:Name="NombreTaller" Style="{StaticResource Campo}" Placeholder="Ej. Taller Ramírez" ReturnType="Next" />
                    </VerticalStackLayout>

                    <!-- Cliente: el taller debe haberte dado de alta antes -->
                    <VerticalStackLayout x:Name="CampoCliente" Spacing="12" IsVisible="False">
                        <Label Text="Tu nombre en el taller" Style="{StaticResource Etiqueta}" />
                        <Picker x:Name="ClienteLista" Title="Elige tu nombre" FontSize="16" HeightRequest="56" />
                    </VerticalStackLayout>

                    <Label Text="Usuario" Style="{StaticResource Etiqueta}" />
                    <Entry x:Name="UsuarioNuevo" Style="{StaticResource Campo}" Placeholder="Ej. admin" ReturnType="Next" />

                    <Label Text="Contraseña (mínimo 6 caracteres)" Style="{StaticResource Etiqueta}" />
                    <Entry x:Name="Clave" Style="{StaticResource Campo}" Placeholder="Contraseña" IsPassword="True" ReturnType="Next" />

                    <Label Text="Confirmar contraseña" Style="{StaticResource Etiqueta}" />
                    <Entry x:Name="Confirmar" Style="{StaticResource Campo}" Placeholder="Repite la contraseña"
                           IsPassword="True" ReturnType="Done" Completed="OnCrear" />

                    <HorizontalStackLayout Spacing="12">
                        <CheckBox CheckedChanged="OnMostrarChanged" Color="{StaticResource Primary}" />
                        <Label Text="Mostrar contraseñas" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <Label x:Name="Error" TextColor="{StaticResource WearDue}" FontSize="14" IsVisible="False" />

                    <Button x:Name="BotonCrear" Style="{StaticResource BotonPrimario}" Clicked="OnCrear" Margin="0,4,0,0" />
                    <Button x:Name="BotonVolver" Text="Ya tengo cuenta" Style="{StaticResource BotonSecundario}" Clicked="OnVolver" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Los datos se guardan solo en este teléfono"
                   Style="{StaticResource Pie}" HorizontalTextAlignment="Center" Margin="16,0,16,32" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
