<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Material;assembly=MauiIcons.Material"
             
             xmlns:fab="clr-namespace:MauiIcons.FontAwesome.Brand;assembly=MauiIcons.FontAwesome.Brand"
x:Class="MotorCore_Garage.Pages.ClienteCuentaPage"
             Style="{StaticResource Pagina}"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <VerticalStackLayout Style="{StaticResource Hero}">
                <Label Text="Mi cuenta" Style="{StaticResource HeroTitulo}" />
                <Label x:Name="NombreDelTaller" Style="{StaticResource HeroSubtitulo}" />
            </VerticalStackLayout>

            <VerticalStackLayout Padding="16,20,16,32" Spacing="20">

                <!-- Identidad del cliente -->
                <Border Style="{StaticResource Tarjeta}" Padding="20">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border BackgroundColor="{StaticResource Secondary}" WidthRequest="64" HeightRequest="64"
                                StrokeThickness="0" StrokeShape="RoundRectangle 32" VerticalOptions="Center">
                            <Label x:Name="Iniciales" FontFamily="NotoSansSemibold" FontSize="20"
                                   TextColor="{StaticResource Graphite}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="Nombre" Style="{StaticResource Seccion}" />
                            <Label x:Name="Usuario" Style="{StaticResource Pie}" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Datos de contacto -->
                <Border Style="{StaticResource Tarjeta}" Padding="0">
                    <VerticalStackLayout>
                        <VerticalStackLayout Padding="20,16" Spacing="4">
                            <Label Text="Teléfono" Style="{StaticResource Etiqueta}" />
                            <Label x:Name="Telefono" Style="{StaticResource Cuerpo}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Escribir al taller por WhatsApp" Style="{StaticResource BotonSecundario}" Clicked="OnWhatsApp"
                        ImageSource="{fab:FontAwesomeBrand Icon=Whatsapp, IconColor=#E8701A, IconSize=20}" Margin="16,0,16,16" />
                <Button Text="Cerrar sesión" ImageSource="{mi:Material Icon=Logout, IconColor=#E8701A, IconSize=20}" Style="{StaticResource BotonSecundario}" Clicked="OnCerrarSesion" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
