<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.ClientesPage"
             Title="Clientes"
             Style="{StaticResource Pagina}">

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" Style="{StaticResource BarraVolver}" ColumnDefinitions="Auto,*">
            <Button Text="‹" FontSize="24" BackgroundColor="Transparent" TextColor="{StaticResource White}"
                    WidthRequest="48" HeightRequest="48" Padding="0" Clicked="OnVolver" />
            <Label Grid.Column="1" Text="Clientes" Style="{StaticResource CabeceraTitulo}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Padding="12,4" Margin="16,16,16,0">
            <Entry x:Name="Buscar" Placeholder="Buscar por nombre, teléfono o placa"
                   FontSize="16" TextChanged="OnBuscar" ClearButtonVisibility="WhileEditing" />
        </Border>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="Lista" Padding="16,12,16,24" Spacing="12" />
        </ScrollView>
    </Grid>
</ContentPage>
