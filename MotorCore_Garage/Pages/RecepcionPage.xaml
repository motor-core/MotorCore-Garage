<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Material;assembly=MauiIcons.Material"
             x:Class="MotorCore_Garage.Pages.RecepcionPage"
             Title="Recepción"
             Style="{StaticResource Pagina}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Style="{StaticResource BarraVolver}" ColumnDefinitions="Auto,*">
            <Button Text="‹" FontSize="24" BackgroundColor="Transparent" TextColor="{StaticResource White}"
                    WidthRequest="48" HeightRequest="48" Padding="0" Clicked="OnVolver" />
            <Label Grid.Column="1" Text="Recepción de vehículo" Style="{StaticResource CabeceraTitulo}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,24" Spacing="10">

                <Label Text="Cita" Style="{StaticResource Etiqueta}" />
                <Picker x:Name="Cita" Title="Selecciona la cita" FontSize="16" HeightRequest="56" SelectedIndexChanged="OnCita" />
                <Label x:Name="ErrorCita" Style="{StaticResource Pie}" TextColor="{StaticResource WearDue}" IsVisible="False" />

                <Label x:Name="Vehiculo" Style="{StaticResource CuerpoStrong}" Margin="0,4,0,0" />

                <Label Text="Kilometraje actual" Style="{StaticResource Etiqueta}" />
                <Entry x:Name="Km" Style="{StaticResource Campo}" Placeholder="Ej. 152340" Keyboard="Numeric" FontSize="24" />
                <Label x:Name="UltimoKm" Style="{StaticResource Pie}" />
                <Label x:Name="ErrorKm" Style="{StaticResource Pie}" TextColor="{StaticResource WearDue}" IsVisible="False" />

                <Label Text="Nivel de combustible" Style="{StaticResource Etiqueta}" />
                <Picker x:Name="Combustible" FontSize="16" HeightRequest="56" />

                <Label Text="Daños visibles u observaciones" Style="{StaticResource Etiqueta}" />
                <Editor x:Name="Observaciones" Placeholder="Ej. Rayón en puerta trasera derecha" HeightRequest="96" FontSize="16" />

                <Label Text="Estado" Style="{StaticResource Etiqueta}" />
                <Picker x:Name="Estado" FontSize="16" HeightRequest="56" />

                <Button Text="Guardar recepción" ImageSource="{mi:Material Icon=Save, IconColor=White, IconSize=20}" Style="{StaticResource BotonPrimario}" Margin="0,16,0,0" Clicked="OnGuardar" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" x:Name="Snack" IsVisible="False" BackgroundColor="{StaticResource Graphite}"
                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,12"
                Margin="16" VerticalOptions="End">
            <Label x:Name="SnackTexto" TextColor="{StaticResource White}" FontSize="14" />
        </Border>
    </Grid>
</ContentPage>
