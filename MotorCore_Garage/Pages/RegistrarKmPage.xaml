<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="clr-namespace:MauiIcons.Material;assembly=MauiIcons.Material"
             x:Class="MotorCore_Garage.Pages.RegistrarKmPage"
             Title="Registrar kilometraje"
             Style="{StaticResource Pagina}">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Style="{StaticResource BarraVolver}" ColumnDefinitions="Auto,*">
            <Button Text="‹" FontSize="24" BackgroundColor="Transparent" TextColor="{StaticResource White}"
                    WidthRequest="48" HeightRequest="48" Padding="0" Clicked="OnVolver" />
            <Label Grid.Column="1" Text="Registrar kilometraje" Style="{StaticResource CabeceraTitulo}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,16,16,24" Spacing="12">

                <Label Text="Vehículo" Style="{StaticResource Etiqueta}" />
                <Picker x:Name="Vehiculo" Title="Selecciona el vehículo" FontSize="16" HeightRequest="56" SelectedIndexChanged="OnVehiculo" />

                <Label x:Name="UltimoKm" Style="{StaticResource Pie}" FontSize="14" />

                <Label Text="Kilometraje actual" Style="{StaticResource Etiqueta}" />
                <Entry x:Name="Km" Placeholder="0" Keyboard="Numeric" FontSize="36" HeightRequest="80"
                       FontFamily="NotoSansSemibold" TextChanged="OnKmCambio" />
                <Label x:Name="ErrorKm" Style="{StaticResource Pie}" TextColor="{StaticResource WearDue}" FontSize="14" IsVisible="False" />

                <Border Style="{StaticResource Tarjeta}" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Alertas que se actualizarán" Style="{StaticResource CuerpoStrong}" />
                        <VerticalStackLayout x:Name="Vista" Spacing="6" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Guardar kilometraje" ImageSource="{mi:Material Icon=Save, IconColor=White, IconSize=20}" Style="{StaticResource BotonPrimario}" Margin="0,8,0,0" Clicked="OnGuardar" />
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" x:Name="Snack" IsVisible="False" BackgroundColor="{StaticResource Graphite}"
                StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,12"
                Margin="16" VerticalOptions="End">
            <Label x:Name="SnackTexto" TextColor="{StaticResource White}" FontSize="14" />
        </Border>
    </Grid>
</ContentPage>
