<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.VehiculosPage"
             Title="Vehículos"
             Style="{StaticResource Pagina}">

    <Grid RowDefinitions="Auto,Auto,*">

        <VerticalStackLayout Grid.Row="0" Style="{StaticResource Hero}">
            <Label Text="Vehículos" Style="{StaticResource HeroTitulo}" />
            <Label Text="Estado de desgaste de cada unidad" Style="{StaticResource HeroSubtitulo}" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Padding="16,16,16,0" Spacing="10">
            <Border Style="{StaticResource Tarjeta}" Padding="12,4">
                <Entry x:Name="Buscar" Placeholder="Buscar por placa o modelo" FontSize="16"
                       TextChanged="OnFiltrar" ClearButtonVisibility="WhileEditing" />
            </Border>
            <Picker x:Name="FiltroEstado" Title="Filtrar por estado de desgaste" FontSize="16" HeightRequest="48"
                    SelectedIndexChanged="OnFiltrar" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="Lista" Padding="16,12,16,96" Spacing="12" />
        </ScrollView>
    </Grid>
</ContentPage>
