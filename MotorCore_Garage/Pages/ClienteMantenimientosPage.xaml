<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.ClienteMantenimientosPage"
             Title="Mantenimientos"
             Style="{StaticResource Pagina}">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Style="{StaticResource BarraVolver}" ColumnDefinitions="Auto,*">
            <Button Text="‹" FontSize="24" BackgroundColor="Transparent" TextColor="{StaticResource White}"
                    WidthRequest="48" HeightRequest="48" Padding="0" Clicked="OnVolver" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Mantenimientos" Style="{StaticResource CabeceraTitulo}" />
                <Label x:Name="Subtitulo" Style="{StaticResource HeroSubtitulo}" FontSize="13" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,32" Spacing="16">
                <Button Text="Programar mantenimiento" Style="{StaticResource BotonPrimario}" Clicked="OnAgregar" />
                <VerticalStackLayout x:Name="Lista" Spacing="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
