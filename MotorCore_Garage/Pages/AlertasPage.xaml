<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MotorCore_Garage.Pages.AlertasPage"
             Title="Alertas"
             Style="{StaticResource Pagina}">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Style="{StaticResource Hero}">
            <Label Text="Alertas" Style="{StaticResource HeroTitulo}" />
            <Label Text="Mantenimiento predictivo por componente" Style="{StaticResource HeroSubtitulo}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="Lista" Padding="16,16,16,96" Spacing="12" />
        </ScrollView>
    </Grid>
</ContentPage>
