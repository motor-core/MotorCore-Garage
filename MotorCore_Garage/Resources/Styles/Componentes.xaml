<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Tipografía: cuerpo 16 sp, acciones 16 sp, leyenda 12 sp -->
    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansDisplaySemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="Titulo" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansDisplaySemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="Seccion" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansDisplaySemibold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="CuerpoStrong" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="Cuerpo" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="Pie" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansRegular" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
    </Style>

    <Style x:Key="Etiqueta" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- Contenedores -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Card}, Dark={StaticResource CardDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Botones de 56 dp para acciones principales -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="NotoSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="FontFamily" Value="NotoSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <Style x:Key="Campo" TargetType="Entry">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <Style x:Key="Pagina" TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <!-- Encabezados: Hero es la cabecera de cada pestaña (taller y cliente); BarraVolver, la de pantallas secundarias -->
    <Style x:Key="Hero" TargetType="VerticalStackLayout">
        <Setter Property="BackgroundColor" Value="{StaticResource Graphite}" />
        <Setter Property="Padding" Value="20,44,20,14" />
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="HeroTitulo" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansDisplaySemibold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
    </Style>

    <Style x:Key="HeroSubtitulo" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource HeaderMuted}" />
    </Style>

    <Style x:Key="BarraVolver" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource Graphite}" />
        <Setter Property="Padding" Value="8,40,16,8" />
    </Style>

    <Style x:Key="CabeceraTitulo" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansDisplaySemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- Mensaje cuando una lista no tiene elementos -->
    <Style x:Key="EstadoVacio" TargetType="Label">
        <Setter Property="FontFamily" Value="NotoSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMuted}, Dark={StaticResource InkMutedDark}}" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>

</ResourceDictionary>
